android-ndk/
android-sdk-ws/
.gradle-home/
.gradle-tmp/

# Flutter and Gradle build output at workspace root
build/

# Flutter compiled output (APKs live in build-output/ after manual build)
flutter_client/build-output/

# Gradle build reports inside flutter_client
flutter_client/android/build/
