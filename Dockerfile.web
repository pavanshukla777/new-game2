FROM node:22-bookworm-slim

WORKDIR /app

RUN npm install -g pnpm@9.15.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./

COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts

RUN pnpm install --no-frozen-lockfile

# Vite config requires these variables during build time
ENV PORT=3000
ENV BASE_PATH=/
ENV NODE_ENV=production

# Build ONLY the web application
RUN pnpm --filter @workspace/web build

# Fail the Docker build if the production files were not created
RUN test -f /app/artifacts/web/dist/public/index.html

EXPOSE 3000

CMD ["pnpm", "--filter", "@workspace/web", "serve"]
